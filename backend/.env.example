# =====================================
# Database Configuration
# =====================================
# Option 1: Local PostgreSQL (Development)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sahel_oxygene
# DB_USER=postgres
# DB_PASSWORD=password

# Option 2: Supabase (Production/Recommended)
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/database
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[SUPABASE_ID].supabase.co:5432/postgres
DB_HOST=db.[SUPABASE_ID].supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-database-password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:5173

# CORS Configuration (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com

# Super Admin Emails (comma-separated)
SUPER_ADMIN_EMAILS=admin@example.com,superadmin@example.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# WhatsApp Configuration (if needed)
WHATSAPP_API_KEY=your-whatsapp-api-key
